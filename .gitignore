# Regenerable Vivado outputs; keep source XCI/BD, RTL, MEM and EDIF.
.Xil/
*.cache/
*.runs/
*.sim/
*.gen/
*.hw/
*.ip_user_files/
**/generated/
*.jou
*.log
*.str
*.pb
*.wdb
*.rpt
*.bit
*.xsa
*.ltx
*.backup.*
# Daily exchange data are intentionally not versioned; regenerated by MATLAB.
/data/input/*
/data/output/*
!/data/input/.gitkeep
!/data/output/.gitkeep
/matlab/vna/output/
# Local hardware delivery outputs
/ps/Debug/
/ps/Release/

# Extracted vendor IP library sources are regenerated by Vivado.
**/ipshared/

*.m.bak
*.asv
/coeff/*.mat
/coeff/*.csv
/matlab/vna/input/*
!/matlab/vna/input/.gitkeep

*.bda
*.rpx

# Disposable online verification project
/validation/online_check/
/validation/ssr_probe/
/validation/ssr_check/
/validation/ssr_continuous/
/validation/diagnostic_check/
/validation/diagnostic_fixed/
# Diagnostic IP sources are XCI; Vivado regenerates the other files.
/ip/ila_stream_diag/*
!/ip/ila_stream_diag/ila_stream_diag.xci
/ip/vio_stream_mode/*
!/ip/vio_stream_mode/vio_stream_mode.xci
/adda/project/ce_fir_adda.srcs/utils_1/imports/synth_1/

# MIF copies emitted at the project root during RTL elaboration
/*.mif
# Only source scripts belong in validation; outputs are regenerated locally.
/validation/*/
*.dcp
*.mif
/adda/bd/*/ui/
